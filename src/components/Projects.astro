---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Firebase from "./icons/Firebase.astro"
import Supabase from "./icons/Supabase.astro"

const TAGS = {
  ASTRO: {
    name: "Astro",
    class: "bg-orange-500/10 text-orange-600 dark:bg-orange-400/10 dark:text-orange-300 border border-orange-200/50 dark:border-orange-500/20",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-cyan-500/10 text-cyan-600 dark:bg-cyan-400/10 dark:text-cyan-300 border border-cyan-200/50 dark:border-cyan-500/20",
    icon: Tailwind,
  },
  FIREBASE: {
    name: "Firebase",
    class: "bg-yellow-500/10 text-yellow-600 dark:bg-yellow-400/10 dark:text-yellow-300 border border-yellow-200/50 dark:border-yellow-500/20",
    icon: Firebase,
  },
  NEXTJS: {
    name: "Next.js",
    class: "bg-gray-500/10 text-gray-700 dark:bg-gray-400/10 dark:text-gray-300 border border-gray-200/50 dark:border-gray-500/20",
    icon: NextJS,
  },
  NESTJS: {
    name: "Nest.js",
    class: "bg-red-500/10 text-red-600 dark:bg-red-400/10 dark:text-red-300 border border-red-200/50 dark:border-red-500/20",
    icon: NextJS,
  },
  SUPABASE: {
    name: "Supabase",
    class: "bg-green-500/10 text-green-600 dark:bg-green-400/10 dark:text-green-300 border border-green-200/50 dark:border-green-500/20",
    icon: Supabase,
  },
}
const PROJECTS = [
  {
    title: "Tendencia Roller",
    description:
      "Nuestra solución, Tendencia Roller, es una tienda de cortinas roller que permite a los usuarios personalizar y cotizar cortinas de forma sencilla y rápida. El sitio cuenta con interfaces intuitivas y fáciles de usar, optimizadas para un E-Commerce.",
    link: "https://www.tendenciaroller.cl/",
    image: "/tendencia_roller.png",
    tags: [TAGS.NEXTJS, TAGS.NESTJS, TAGS.SUPABASE],
  },
  {
    title: "CareMind IA",
    description:
      "Una página web diseñada para ofrecer ayuda psicológica y académica a los usuarios, integrando soluciones de inteligencia artificial.",
    link: "https://caremind-ia.netlify.app/",
    github: "https://github.com/bquezadag/Caremind-IA",
    image: "/435shots_so.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.FIREBASE],
  },
  {
    title: "CardioCare IA",
    description:
      "Una solución web diseñada para ofrecer una experiencia fácil de usar y accesible para todos los usuarios, enfocada en el cuidado cardíaco con apoyo de inteligencia artificial.",
    link: "https://cardio-care-ia.vercel.app/",
    github: "https://github.com/vicenteroa/CardioCare-IA",
    image: "/cardiocare.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.FIREBASE],
  },
]
---

<style>
  .project-card {
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
  }

  .project-image-wrapper {
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .project-image-wrapper img {
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-image-wrapper img {
    transform: scale(1.04);
  }

  .card-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(139, 92, 246, 0.06), transparent 40%);
    pointer-events: none;
  }

  .project-card:hover .card-glow {
    opacity: 1;
  }
</style>

<div class="flex flex-col gap-y-12">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }, index) => (
      <article class="project-card group relative rounded-2xl bg-white/60 dark:bg-white/[0.03] border border-gray-200/80 dark:border-white/[0.06] shadow-sm dark:shadow-none overflow-hidden p-1">
        <div class="card-glow"></div>
        <div class="flex flex-col md:flex-row gap-0 md:gap-0 rounded-xl overflow-hidden">

          <!-- Image -->
          <div class="w-full md:w-5/12 project-image-wrapper">
            <img
              alt={`Screenshot de ${title}`}
              class="w-full h-52 md:h-full object-cover object-top"
              loading="lazy"
              src={image}
            />
          </div>

          <!-- Content -->
          <div class="w-full md:w-7/12 p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-3">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                  {title}
                </h3>
                <span class="text-xs font-medium text-gray-400 dark:text-gray-500 mt-1">
                  #{String(index + 1).padStart(2, '0')}
                </span>
              </div>

              <ul class="flex flex-wrap gap-2 mb-4">
                {tags.map((tag) => (
                  <li>
                    <span class={`flex items-center gap-1.5 rounded-full text-xs font-medium py-1 px-2.5 ${tag.class}`}>
                      <tag.icon class="size-3" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>

              <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400 text-justify">
                {description}
              </p>
            </div>

            <footer class="flex items-center gap-3 mt-5">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-4" />
                  Código
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
