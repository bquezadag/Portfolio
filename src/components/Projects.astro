---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Firebase from "./icons/Firebase.astro"
import Supabase from "./icons/Supabase.astro"
import NestJS from "./icons/NestJS.astro"
import AstroIcon from "./icons/AstroIcon.astro"

const TAGS = {
  ASTRO:     { name:"Astro",        class:"bg-orange-500/10  text-orange-500  dark:text-orange-300  border border-orange-400/20",  icon: AstroIcon },
  TAILWIND:  { name:"Tailwind CSS", class:"bg-cyan-500/10    text-cyan-600    dark:text-cyan-300    border border-cyan-400/20",    icon: Tailwind  },
  FIREBASE:  { name:"Firebase",     class:"bg-yellow-500/10  text-yellow-600  dark:text-yellow-300  border border-yellow-400/20",  icon: Firebase  },
  NEXTJS:    { name:"Next.js",      class:"bg-gray-500/10    text-gray-700    dark:text-gray-300    border border-gray-400/20",    icon: NextJS    },
  NESTJS:    { name:"Nest.js",      class:"bg-red-500/10     text-red-600     dark:text-red-300     border border-red-400/20",     icon: NestJS    },
  SUPABASE:  { name:"Supabase",     class:"bg-emerald-500/10 text-emerald-600 dark:text-emerald-300 border border-emerald-400/20", icon: Supabase  },
}

const PROJECTS = [
  {
    title: "Tendencia Roller",
    description: "Tienda de cortinas roller que permite a los usuarios personalizar y cotizar cortinas de forma sencilla. Interfaces intuitivas optimizadas para E-Commerce.",
    link: "https://www.tendenciaroller.cl/",
    image: "/tendencia_roller.png",
    tags: [TAGS.NEXTJS, TAGS.NESTJS, TAGS.SUPABASE],
    featured: true,
  },
  {
    title: "CareMind IA",
    description: "Plataforma de ayuda psicológica y académica con inteligencia artificial integrada.",
    link: "https://caremind-ia.netlify.app/",
    github: "https://github.com/bquezadag/Caremind-IA",
    image: "/435shots_so.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.FIREBASE],
  },
  {
    title: "CardioCare IA",
    description: "Solución de cuidado cardíaco con apoyo de inteligencia artificial, accesible para todos.",
    link: "https://cardio-care-ia.vercel.app/",
    github: "https://github.com/vicenteroa/CardioCare-IA",
    image: "/cardiocare.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.FIREBASE],
  },
]
---

<style>
  /* Bento grid */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: auto auto;
    }
    .bento-featured {
      grid-column: 1 / 4;
      grid-row: 1 / 3;
    }
    .bento-sm:nth-child(2) { grid-column: 4 / 6; grid-row: 1; }
    .bento-sm:nth-child(3) { grid-column: 4 / 6; grid-row: 2; }
  }

  /* Card */
  .proj-card {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: var(--c-card);
    border: 1px solid var(--c-border);
    backdrop-filter: blur(18px);
    transition: border-color 0.25s, transform 0.3s cubic-bezier(0.16,1,0.3,1), box-shadow 0.3s;
  }
  .proj-card:hover {
    border-color: var(--c-border-h);
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.12);
  }
  .dark .proj-card:hover {
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
  }

  /* Image zoom */
  .proj-img {
    overflow: hidden;
  }
  .proj-img img {
    transition: transform 0.5s cubic-bezier(0.16,1,0.3,1);
  }
  .proj-card:hover .proj-img img {
    transform: scale(1.05);
  }

  /* Featured card image taller */
  .bento-featured .proj-img { height: 220px; }
  .bento-sm .proj-img       { height: 130px; }

  @media (min-width: 768px) {
    .bento-featured .proj-img { height: 300px; }
    .bento-sm .proj-img       { height: 150px; }
  }

  /* Gradient overlay on image */
  .img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.45) 100%);
    pointer-events: none;
  }
  .dark .img-overlay {
    background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.65) 100%);
  }

  /* Number badge */
  .proj-num {
    position: absolute;
    top: 0.75rem; right: 0.75rem;
    font-size: 10px;
    font-weight: 700;
    font-family: monospace;
    letter-spacing: 0.1em;
    padding: 2px 8px;
    border-radius: 99px;
    background: rgba(0,0,0,0.45);
    color: rgba(255,255,255,0.7);
    backdrop-filter: blur(8px);
  }
</style>

<div class="bento">
  {PROJECTS.map(({ image, title, description, tags, link, github, featured }, i) => (
    <article
      data-animate
      data-delay={String(i + 1)}
      class={`proj-card ${featured ? 'bento-featured' : 'bento-sm'}`}
    >
      <!-- Top accent line -->
      <div class="h-[1.5px] bg-gradient-to-r from-violet-500/60 via-blue-400/30 to-transparent"></div>

      <!-- Image -->
      <div class="proj-img relative">
        <img
          alt={`Preview de ${title}`}
          class="w-full h-full object-cover object-top"
          loading="lazy"
          src={image}
        />
        <div class="img-overlay"></div>
        <span class="proj-num">#{String(i + 1).padStart(2, '0')}</span>
      </div>

      <!-- Body -->
      <div class={`p-5 ${featured ? 'sm:p-6' : ''}`}>
        <h3 class={`font-bold text-[--c-text] mb-2 ${featured ? 'text-xl' : 'text-base'}`}>
          {title}
        </h3>

        <ul class="flex flex-wrap gap-1.5 mb-3">
          {tags.map(tag => (
            <li>
              <span class={`flex items-center gap-1 rounded-full text-[10px] font-semibold py-0.5 px-2 ${tag.class}`}>
                <tag.icon class="size-2.5" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

        {featured && (
          <p class="text-sm leading-relaxed text-[--c-muted] mb-4">
            {description}
          </p>
        )}

        <footer class="flex items-center gap-2">
          {github && (
            <LinkButton href={github}>
              <GitHub class="size-3.5" />
              Código
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link}>
              <Link class="size-3.5" />
              Preview
            </LinkButton>
          )}
        </footer>
      </div>
    </article>
  ))}
</div>
