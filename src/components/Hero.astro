---
const personalImageAlt = "Benjamín Quezada"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<style>
  /* Entry animations */
  @keyframes fadeUp {
    from { opacity:0; transform:translateY(22px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes fadeRight {
    from { opacity:0; transform:translateX(28px); }
    to   { opacity:1; transform:translateX(0); }
  }
  @keyframes scrollMarquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes ping {
    75%,100% { transform:scale(2); opacity:0; }
  }

  .anim-0 { animation: fadeUp 0.6s cubic-bezier(0.16,1,0.3,1) 0.05s both; }
  .anim-1 { animation: fadeUp 0.6s cubic-bezier(0.16,1,0.3,1) 0.15s both; }
  .anim-2 { animation: fadeUp 0.6s cubic-bezier(0.16,1,0.3,1) 0.28s both; }
  .anim-3 { animation: fadeUp 0.6s cubic-bezier(0.16,1,0.3,1) 0.40s both; }
  .anim-4 { animation: fadeUp 0.6s cubic-bezier(0.16,1,0.3,1) 0.52s both; }
  .anim-right { animation: fadeRight 0.8s cubic-bezier(0.16,1,0.3,1) 0.2s both; }

  /* Photo with gradient border */
  .photo-frame {
    position: relative;
    display: inline-block;
    border-radius: 22px;
  }
  .photo-frame::before {
    content:'';
    position:absolute; inset:-2px;
    border-radius:24px;
    background:linear-gradient(135deg,#71717a,#a1a1aa,#d4d4d8);
    z-index:-1;
    opacity:0.75;
  }
  .photo-frame::after {
    content:'';
    position:absolute; inset:-30px;
    border-radius:40px;
    background:linear-gradient(135deg,rgba(113,113,122,0.18),rgba(113,113,122,0.08));
    filter:blur(30px);
    z-index:-2;
  }

  /* Role line */
  .role-line::before {
    content:'';
    display:inline-block;
    width:2.5rem; height:2px;
    background:linear-gradient(90deg,#71717a,#a1a1aa);
    border-radius:99px;
    vertical-align:middle;
    margin-right:0.6rem;
    margin-bottom:2px;
  }

  /* Tech marquee */
  .marquee-wrap {
    -webkit-mask: linear-gradient(90deg,transparent 0%,#000 7%,#000 93%,transparent 100%);
    mask: linear-gradient(90deg,transparent 0%,#000 7%,#000 93%,transparent 100%);
    overflow:hidden;
    padding:0.4rem 0;
  }
  .marquee-track {
    display:flex; gap:0.75rem;
    width:fit-content;
    animation: scrollMarquee 80s linear infinite;
  }
  .marquee-track:hover { animation-play-state:paused; }

  /* Stats card */
  .stat-item + .stat-item { border-left:1px solid var(--c-border); }

  /* CV button */
  .btn-cv {
    background: linear-gradient(135deg,#3f3f46,#52525b);
    color:#fff;
    border:none;
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    transition: box-shadow 0.25s, transform 0.2s;
  }
  .btn-cv:hover {
    box-shadow: 0 6px 28px rgba(0,0,0,0.35);
    transform: translateY(-1px);
  }

  /* Divider */
  .fade-line {
    height:1px;
    background:linear-gradient(90deg,transparent,rgba(113,113,122,0.45),rgba(161,161,170,0.25),transparent);
  }


</style>

<section class="w-full max-w-screen-xl mx-auto px-6 lg:px-16 pt-24 pb-10 sm:pt-28">

  <!-- TWO-COLUMN HERO -->
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-12 lg:gap-20 items-start">

    <!-- ── LEFT ── -->
    <div>
      <!-- Available badge -->
      <div class="anim-0 mb-7">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wide
          bg-emerald-500/10 text-emerald-600 dark:text-emerald-400
          border border-emerald-500/20 dark:border-emerald-500/25">
          <span class="relative inline-flex size-2">
            <span class="animate-[ping_1.5s_ease_infinite] absolute inline-flex size-full rounded-full bg-emerald-400 opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
          </span>
          Disponible Freelance
        </span>
      </div>

      <!-- Name -->
      <div class="anim-1 mb-5">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-[--c-muted] mb-2">
          Hola, soy
        </p>
        <h1 class="text-gradient text-[clamp(3rem,8vw,5.5rem)] font-extrabold tracking-tighter leading-[0.95]">
          Benjamín<br />Quezada
        </h1>
      </div>

      <!-- Role -->
      <p class="anim-2 role-line text-base font-semibold text-zinc-600 dark:text-zinc-400 mb-6">
        Fullstack Developer · Ing. en Computación
      </p>

      <!-- Bio -->
      <p class="anim-3 text-base leading-relaxed text-[--c-muted] mb-9 max-w-md">
        Especializado en <strong class="text-[--c-text] font-semibold">arquitectura limpia</strong> con NestJS, React y TypeScript,
        y en el desarrollo de <strong class="text-[--c-text] font-semibold">agentes de inteligencia artificial</strong>.
        Lidero proyectos y entrego soluciones escalables de alto impacto.
      </p>

      <!-- CTAs -->
      <nav class="anim-4 flex flex-wrap gap-2.5">
        <SocialPill href="https://linkedin.com/in/benjaminqg">
          <LinkedInIcon class="size-4" />
          LinkedIn
        </SocialPill>
        <a href="/cv.pdf" target="_blank"
          class="btn-cv inline-flex items-center gap-2 px-4 py-1.5 text-sm font-semibold rounded-full focus:outline-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
            <path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1-2-2v-14a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z" />
            <path d="M9 13l6 0" /><path d="M9 17l6 0" />
          </svg>
          Descargar CV
        </a>
      </nav>
    </div>

    <!-- ── RIGHT ── -->
    <div class="anim-right flex flex-col items-center lg:items-start gap-5 lg:pt-10">

      <!-- Photo -->
      <div class="relative w-full max-w-[240px] lg:max-w-full flex justify-center">
        <div class="photo-frame">
          <img
            class="w-48 h-48 lg:w-52 lg:h-52 object-cover rounded-[20px]"
            src="/yo.jfif"
            alt={personalImageAlt}
            style="object-position:center center"
          />
        </div>
      </div>

      <!-- Stats card -->
      <div class="glass rounded-2xl w-full max-w-[240px] lg:max-w-full overflow-hidden">
        <div class="flex divide-x divide-[--c-border]">
          <div class="stat-item flex-1 flex flex-col items-center py-4 px-2">
            <span class="text-2xl font-bold text-[--c-text]">2+</span>
            <span class="text-[10px] font-medium uppercase tracking-wider text-[--c-muted] mt-0.5">años exp.</span>
          </div>
          <div class="stat-item flex-1 flex flex-col items-center py-4 px-2">
            <span class="text-2xl font-bold text-[--c-text]">3</span>
            <span class="text-[10px] font-medium uppercase tracking-wider text-[--c-muted] mt-0.5">proyectos</span>
          </div>
          <div class="stat-item flex-1 flex flex-col items-center py-4 px-2">
            <span class="text-2xl font-bold text-[--c-text]">3</span>
            <span class="text-[10px] font-medium uppercase tracking-wider text-[--c-muted] mt-0.5">certs.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TECH STACK MARQUEE -->
  <div class="mt-16 anim-4">
    <div class="fade-line mb-6"></div>
    <p class="text-[11px] font-bold tracking-[0.22em] uppercase text-[--c-muted] mb-4">
      Stack tecnológico
    </p>
    <div class="marquee-wrap">
      <div class="marquee-track">
        <!-- Set 1 -->
        <div class="flex gap-3 shrink-0">
          <SocialPill href="https://react.dev/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/react/react-original.svg" class="size-4" alt="React"/>React</SocialPill>
          <SocialPill href="https://nestjs.com/" target="_blank"><img src="https://www.vectorlogo.zone/logos/nestjs/nestjs-icon.svg" class="size-4" alt="NestJS"/>NestJS</SocialPill>
          <SocialPill href="https://nextjs.org/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/nextjs/nextjs-original.svg" class="size-4" alt="NextJS"/>NextJS</SocialPill>
          <SocialPill href="https://www.typescriptlang.org/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/typescript/typescript-original.svg" class="size-4" alt="TypeScript"/>TypeScript</SocialPill>
          <SocialPill href="https://www.javascript.com/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/javascript/javascript-original.svg" class="size-4" alt="JavaScript"/>JavaScript</SocialPill>
          <SocialPill href="https://www.python.org/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/python/python-original.svg" class="size-4" alt="Python"/>Python</SocialPill>
          <SocialPill href="https://www.postgresql.org/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/postgresql/postgresql-original.svg" class="size-4" alt="PostgreSQL"/>PostgreSQL</SocialPill>
          <SocialPill href="https://www.docker.com/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/docker/docker-original.svg" class="size-4" alt="Docker"/>Docker</SocialPill>
          <SocialPill href="https://firebase.google.com/" target="_blank"><img src="https://www.vectorlogo.zone/logos/firebase/firebase-icon.svg" class="size-4" alt="Firebase"/>Firebase</SocialPill>
          <SocialPill href="https://www.postman.com/" target="_blank"><img src="https://www.vectorlogo.zone/logos/getpostman/getpostman-icon.svg" class="size-4" alt="Postman"/>Postman</SocialPill>
        </div>
        <!-- Set 2 (duplicate for seamless loop) -->
        <div class="flex gap-3 shrink-0">
          <SocialPill href="https://react.dev/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/react/react-original.svg" class="size-4" alt="React"/>React</SocialPill>
          <SocialPill href="https://nestjs.com/" target="_blank"><img src="https://www.vectorlogo.zone/logos/nestjs/nestjs-icon.svg" class="size-4" alt="NestJS"/>NestJS</SocialPill>
          <SocialPill href="https://nextjs.org/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/nextjs/nextjs-original.svg" class="size-4" alt="NextJS"/>NextJS</SocialPill>
          <SocialPill href="https://www.typescriptlang.org/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/typescript/typescript-original.svg" class="size-4" alt="TypeScript"/>TypeScript</SocialPill>
          <SocialPill href="https://www.javascript.com/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/javascript/javascript-original.svg" class="size-4" alt="JavaScript"/>JavaScript</SocialPill>
          <SocialPill href="https://www.python.org/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/python/python-original.svg" class="size-4" alt="Python"/>Python</SocialPill>
          <SocialPill href="https://www.postgresql.org/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/postgresql/postgresql-original.svg" class="size-4" alt="PostgreSQL"/>PostgreSQL</SocialPill>
          <SocialPill href="https://www.docker.com/" target="_blank"><img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/docker/docker-original.svg" class="size-4" alt="Docker"/>Docker</SocialPill>
          <SocialPill href="https://firebase.google.com/" target="_blank"><img src="https://www.vectorlogo.zone/logos/firebase/firebase-icon.svg" class="size-4" alt="Firebase"/>Firebase</SocialPill>
          <SocialPill href="https://www.postman.com/" target="_blank"><img src="https://www.vectorlogo.zone/logos/getpostman/getpostman-icon.svg" class="size-4" alt="Postman"/>Postman</SocialPill>
        </div>
      </div>
    </div>
  </div>
</section>
