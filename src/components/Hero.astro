---
const personalImageAlt = "Benjamín Quezada"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<style>
  @keyframes infinite-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50%)); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .hero-name {
    background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 50%, #34d399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :global(.dark) .hero-name {
    background: linear-gradient(135deg, #c4b5fd 0%, #93c5fd 50%, #6ee7b7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .animate-fade-up {
    animation: fadeInUp 0.7s ease both;
  }

  .animate-fade-up-delay-1 {
    animation: fadeInUp 0.7s ease 0.1s both;
  }

  .animate-fade-up-delay-2 {
    animation: fadeInUp 0.7s ease 0.2s both;
  }

  .animate-fade-up-delay-3 {
    animation: fadeInUp 0.7s ease 0.3s both;
  }

  .animate-fade-up-delay-4 {
    animation: fadeInUp 0.7s ease 0.4s both;
  }

  .profile-ring {
    position: relative;
  }

  .profile-ring::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    background: linear-gradient(135deg, #a78bfa, #60a5fa, #34d399);
    z-index: -1;
    opacity: 0.7;
  }

  :global(.dark) .profile-ring::before {
    opacity: 1;
  }

  .tech-stack {
    position: relative;
    overflow: hidden;
    padding: 0.75rem 0;
    -webkit-mask: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
    mask: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .tech-stack-track {
    display: flex;
    gap: 0.75rem;
    width: fit-content;
    animation: infinite-scroll 30s linear infinite;
  }

  .tech-stack-track:hover {
    animation-play-state: paused;
  }

  .divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(167,139,250,0.3), transparent);
  }

  :global(.dark) .divider {
    background: linear-gradient(90deg, transparent, rgba(167,139,250,0.5), transparent);
  }
</style>

<div class="max-w-3xl mx-auto px-6 py-12 sm:px-8 sm:py-16">
  <!-- Avatar + badge row -->
  <div class="flex items-center gap-6 mb-8 animate-fade-up">
    <div class="profile-ring">
      <img
        class="rounded-full size-20 sm:size-24 object-cover"
        src="/yo.jfif"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="https://linkedin.com/in/benjaminqg"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible</Badge>
    </a>
  </div>

  <!-- Name -->
  <h1 class="text-4xl font-bold tracking-tight sm:text-6xl mb-4 animate-fade-up-delay-1">
    Hola, Soy <span class="hero-name">Benjamín.</span>
  </h1>

  <!-- Bio -->
  <p class="mt-4 text-xl leading-relaxed text-gray-700 dark:[&>strong]:text-violet-300 [&>strong]:text-violet-600 [&>strong]:font-semibold dark:text-gray-300 mb-10 animate-fade-up-delay-2">
    <strong>Ingeniero en Computación e Informática</strong><br />
    Con experiencia como Desarrollador Fullstack, especializado en arquitectura limpia y tecnologías modernas como NestJS, React, TypeScript y JavaScript. Me destaco por mi capacidad de liderar proyectos, colaborar en equipos multidisciplinarios y entregar soluciones escalables y de alto impacto.
  </p>

  <!-- CTA buttons -->
  <nav class="flex flex-wrap gap-3 mb-14 animate-fade-up-delay-3">
    <SocialPill href="mailto:b.quezadagodoy@gmail.com">
      <MailIcon class="size-4" />
      Contacto
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/benjaminqg">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="tel:+56966188938">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      Teléfono
    </SocialPill>
    <SocialPill href="/cv.pdf" target="_blank">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
        <path d="M14 3v4a1 1 0 0 0 1 1h4" />
        <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
        <path d="M9 9l1 0" />
        <path d="M9 13l6 0" />
        <path d="M9 17l6 0" />
      </svg>
      Descargar CV
    </SocialPill>
  </nav>

  <!-- Tech stack -->
  <section class="space-y-5 animate-fade-up-delay-4">
    <div class="divider"></div>
    <h2 class="text-lg font-semibold tracking-wide text-gray-500 dark:text-gray-400 uppercase text-sm">
      Mi stack tecnológico
    </h2>
    <div class="tech-stack">
      <div class="tech-stack-track">
        <div class="flex gap-3">
          <SocialPill href="https://react.dev/" target="_blank">
            <img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/react/react-original.svg" class="size-4" alt="React" />
            React
