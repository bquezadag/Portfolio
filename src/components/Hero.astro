          <SocialPill href="https://www.npmjs.com/" target="_blank">
            <img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/npm/npm-original-wordmark.svg" class="size-4" alt="NPM" />
            NPM
          </SocialPill>
