      <span class="text-sm text-[--c-muted]">
        © {currentYear}
        <a href="#" class="font-semibold text-[--c-text] hover:text-violet-600 dark:hover:text-violet-400 transition-colors">
          bqdev
        </a>
        · Todos los derechos reservados
      </span>
    </div>
    <ul class="flex items-center gap-6 text-sm text-[--c-muted]">
