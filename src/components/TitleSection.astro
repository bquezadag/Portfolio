---
const { number, class: className } = Astro.props
---

<style>
  @keyframes shimmer-line {
    from { transform: translateX(-100%); }
    to   { transform: translateX(500%); }
  }
  .title-shimmer {
    animation: shimmer-line 2.8s cubic-bezier(0.4,0,0.6,1) both;
    animation-delay: 0.4s;
  }
</style>

<div class={`mb-10 ${className ?? ''}`} data-animate>
  {number && (
    <span class="inline-block text-[11px] font-bold tracking-[0.25em] uppercase
      text-zinc-600 dark:text-zinc-400 mb-3">
      {number}
    </span>
  )}
  <h2 class="flex items-center gap-3 text-2xl sm:text-3xl font-bold tracking-tight
    text-gray-900 dark:text-white/95
    [&>svg]:text-zinc-500 dark:[&>svg]:text-zinc-400
    [&>svg]:shrink-0">
    <slot />
  </h2>
  <div class="relative mt-4 h-px bg-gradient-to-r
    from-zinc-500/50 via-zinc-400/25 to-transparent
    dark:from-zinc-400/50 dark:via-zinc-400/20 dark:to-transparent overflow-hidden">
    <span class="title-shimmer absolute top-0 left-0 h-full w-24
      bg-gradient-to-r from-transparent via-zinc-400/80 to-transparent
      dark:via-zinc-300/70"></span>
  </div>
</div>
