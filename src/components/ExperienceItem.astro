---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
}

const { title, company, description, link, date } = Astro.props
---

<style>
  .experience-card {
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .experience-card:hover {
    transform: translateY(-2px);
  }
</style>

<div
  class="relative mx-4 pb-10 grid before:absolute before:left-[-25px] before:block before:h-full before:border-l-2 before:border-violet-300/40 dark:before:border-violet-600/30 before:content-[''] md:grid-cols-5 md:gap-10 md:mx-8"
>
  <div class="relative pb-8 md:col-span-2">
    <div class="sticky top-8">
      <!-- Timeline dot -->
      <span class="absolute -left-[34px] flex items-center justify-center size-4 rounded-full bg-violet-500 dark:bg-violet-500 ring-4 ring-white dark:ring-[#050814] top-1">
      </span>

      <h3 class="text-lg font-bold text-violet-600 dark:text-violet-400 leading-tight">{title}</h3>
      <h4 class="font-semibold text-base text-gray-700 dark:text-gray-200 mt-0.5">{company}</h4>
      <time class="inline-block mt-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-white/5 px-2 py-0.5 rounded-full">{date}</time>
    </div>
  </div>

  <div class="experience-card relative flex flex-col gap-3 pb-4 md:col-span-3 text-justify">
    <div class="p-4 rounded-xl bg-white/60 dark:bg-white/[0.03] border border-gray-200/80 dark:border-white/[0.06] shadow-sm dark:shadow-none">
      <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
        {description}
      </p>
      {
        link && (
          <div class="mt-3">
            <LinkInline href={link}>
              Saber más{" "}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 icon icon-tabler icon-tabler-chevron-right"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M9 6l6 6l-6 6" />
                </>
              </svg>
            </LinkInline>
          </div>
        )
      }
    </div>
  </div>
</div>
