---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
  index?: number
}

const { title, company, description, link, date, index = 0 } = Astro.props
const num = String(index + 1).padStart(2, '0')
---

<style>
  .exp-card {
    transition: border-color 0.25s, transform 0.3s cubic-bezier(0.16,1,0.3,1);
  }
  .exp-card:hover {
    border-color: var(--c-border-h);
    transform: translateX(4px);
  }
</style>

<div data-animate class="exp-card glass rounded-2xl overflow-hidden">
  <!-- Top accent line -->
  <div class="h-[1.5px] bg-gradient-to-r from-violet-500/60 via-blue-400/40 to-transparent"></div>
  <div class="p-6 sm:p-7">
  <div class="flex flex-col sm:flex-row sm:items-start gap-5">

    <!-- Number badge -->
    <div class="flex-shrink-0">
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl
        bg-violet-500/10 dark:bg-violet-500/15
        border border-violet-500/20 dark:border-violet-500/25
        text-sm font-bold text-violet-600 dark:text-violet-400 font-mono">
        {num}
      </span>
    </div>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
        <div>
          <h3 class="text-base font-bold text-[--c-text]">{title}</h3>
          <p class="text-sm font-semibold text-violet-600 dark:text-violet-400 mt-0.5">{company}</p>
        </div>
        <time class="shrink-0 text-xs font-medium px-2.5 py-1 rounded-full
          bg-gray-100 dark:bg-white/[0.05]
          text-gray-500 dark:text-white/40
          border border-gray-200 dark:border-white/[0.06]">
          {date}
        </time>
      </div>

      <p class="text-sm leading-relaxed text-[--c-muted] text-justify">
        {description}
      </p>

      {link && (
        <div class="mt-3">
          <LinkInline href={link}>
            Saber más
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 inline-block" viewBox="0 0 24 24"
              stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </svg>
          </LinkInline>
        </div>
      )}
    </div>
  </div>
  </div>
</div>
