---
import ThemeToggle from "./ThemeToggle.astro"

const navItems = [
  { title: "Experiencia", label: "experiencia", url: "/#experiencia" },
  { title: "Proyectos",   label: "proyectos",   url: "/#proyectos"   },
  { title: "Sobre mí",    label: "sobre-mi",    url: "/#sobre-mi"    },
  { title: "Contacto",    label: "contacto",    url: "/#contacto" },
]
---

<header class="fixed top-0 z-10 w-full flex justify-center mt-3 px-4">
  <nav id="main-nav"
    class="relative flex items-center gap-1 px-3 py-1.5 rounded-full
    text-sm font-medium
    text-gray-600 dark:text-gray-300
    bg-white/60 dark:bg-[#0c0c0c]/70
    border border-gray-200/60 dark:border-white/[0.07]
    backdrop-blur-xl shadow-sm dark:shadow-none
    transition-all duration-500"
  >
    <!-- Active slide indicator -->
    <span id="nav-indicator"
      class="absolute h-7 rounded-full bg-zinc-500/10 dark:bg-zinc-500/15 border border-zinc-400/20
      transition-all duration-300 ease-out opacity-0 pointer-events-none"
    ></span>

    {navItems.map((link) => (
      <a
        class="relative z-10 px-3 py-1 rounded-full transition-colors duration-200
          hover:text-zinc-600 dark:hover:text-zinc-400"
        aria-label={link.label}
        href={link.url}
      >
        {link.title}
      </a>
    ))}
    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections   = document.querySelectorAll("section[id]")
    const navLinks   = document.querySelectorAll<HTMLAnchorElement>("#main-nav a[aria-label]")
    const indicator  = document.getElementById("nav-indicator")

    // Active section via IntersectionObserver
    const setActive = (id: string) => {
      navLinks.forEach(link => {
        const isActive = link.getAttribute("aria-label") === id
        link.classList.toggle("text-zinc-600",       isActive)
        link.classList.toggle("dark:text-zinc-400",  isActive)
        link.classList.toggle("font-semibold",         isActive)
        if (isActive && indicator) moveIndicator(link)
      })
    }

    const moveIndicator = (el: HTMLElement) => {
      if (!indicator) return
      const nav  = document.getElementById("main-nav")!
      const navR = nav.getBoundingClientRect()
      const elR  = el.getBoundingClientRect()
      indicator.style.width   = `${elR.width}px`
      indicator.style.left    = `${elR.left - navR.left}px`
      indicator.style.opacity = "1"
    }

    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) setActive(e.target.id) })
    }, { threshold: 0.3 })

    sections.forEach(s => obs.observe(s))

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        obs.disconnect()
      } else {
        sections.forEach(s => obs.observe(s))
      }
    }
  })
</script>

<style>
  #main-nav {
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 120px;
  }

  @keyframes nav-appear {
    to {
      box-shadow: 0 8px 32px rgba(0,0,0,0.12);
      background-color: rgba(255,255,255,0.85);
    }
  }

  :global(.dark) #main-nav {
    animation: nav-appear-dark 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 120px;
  }

  @keyframes nav-appear-dark {
    to {
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      background-color: rgba(12,12,12,0.85);
    }
  }
</style>
