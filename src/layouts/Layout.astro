---
import "@fontsource-variable/onest"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>

  <body class="relative text-[--c-text]">

    <!-- Top accent line -->
    <div class="fixed top-0 left-0 right-0 h-[1px] z-50 pointer-events-none
      bg-gradient-to-r from-transparent via-zinc-400 to-transparent opacity-60"></div>

    <!-- Base bg -->
    <div class="fixed inset-0 z-[-2] bg-[#e8e4dd] dark:bg-[#000000]"></div>

    <!-- Dot grid (light: dark dots, dark: white dots) -->
    <div class="fixed inset-0 z-[-1] pointer-events-none dot-grid-bg"></div>

    <Header />
    <slot />
    <Footer />

    <style is:global>
      :root {
        color-scheme: light dark;
        --c-text:        rgba(15, 15, 15, 0.90);
        --c-muted:       rgba(82, 82, 91, 0.70);
        --c-card:        rgba(255,255,255,0.65);
        --c-border:      rgba(0,0,0,0.07);
        --c-border-h:    rgba(0,0,0,0.18);
        --hero-grad:     linear-gradient(135deg,#0f0f0f 0%,#3f3f46 100%);
        --accent:        #3f3f46;
      }
      .dark {
        --c-text:        rgba(240, 240, 240, 0.92);
        --c-muted:       rgba(161, 161, 170, 0.60);
        --c-card:        rgba(255,255,255,0.04);
        --c-border:      rgba(255,255,255,0.07);
        --c-border-h:    rgba(255,255,255,0.18);
        --hero-grad:     linear-gradient(135deg,#ffffff 0%,#d4d4d8 50%,#a1a1aa 100%);
        --accent:        #e4e4e7;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Dot grid */
      .dot-grid-bg {
        background-image: radial-gradient(circle, rgba(0,0,0,0.12) 1.5px, transparent 1.5px);
        background-size: 30px 30px;
      }
      .dark .dot-grid-bg {
        background-image: radial-gradient(circle, rgba(255,255,255,0.20) 1.5px, transparent 1.5px);
      }

      /* Gradient text */
      .text-gradient {
        background: var(--hero-grad);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      /* Glass card */
      .glass {
        background: var(--c-card);
        border: 1px solid var(--c-border);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: border-color 0.25s;
      }
      .glass:hover { border-color: var(--c-border-h); }

      /* Gradient border (wrapper trick) */
      .grad-border {
        position: relative;
        border-radius: 18px;
      }
      .grad-border::before {
        content: '';
        position: absolute;
        inset: -1px;
        border-radius: 19px;
        background: linear-gradient(135deg,#52525b,#71717a,#a1a1aa);
        z-index: -1;
        opacity: 0.40;
        transition: opacity 0.3s;
      }
      .grad-border:hover::before { opacity: 0.70; }

      /* Scroll reveal */
      [data-animate] {
        opacity: 0;
        transform: translateY(24px);
        transition:
          opacity  0.65s cubic-bezier(0.16,1,0.3,1),
          transform 0.65s cubic-bezier(0.16,1,0.3,1);
      }
      [data-animate].visible { opacity:1; transform:translateY(0); }
      [data-animate][data-delay="1"] { transition-delay: 0.07s; }
      [data-animate][data-delay="2"] { transition-delay: 0.15s; }
      [data-animate][data-delay="3"] { transition-delay: 0.24s; }
      [data-animate][data-delay="4"] { transition-delay: 0.34s; }
      [data-animate][data-delay="5"] { transition-delay: 0.46s; }
      [data-animate][data-delay="6"] { transition-delay: 0.58s; }

      /* Slide in from left */
      [data-animate-x] {
        opacity: 0;
        transform: translateX(-20px);
        transition:
          opacity  0.6s cubic-bezier(0.16,1,0.3,1),
          transform 0.6s cubic-bezier(0.16,1,0.3,1);
      }
      [data-animate-x].visible { opacity:1; transform:translateX(0); }
      [data-animate-x][data-delay="1"] { transition-delay: 0.08s; }
      [data-animate-x][data-delay="2"] { transition-delay: 0.18s; }
      [data-animate-x][data-delay="3"] { transition-delay: 0.28s; }

      /* Selection */
      ::selection {
        background: rgba(255,255,255,0.20);
        color: #fff;
      }

      /* Scrollbar */
      ::-webkit-scrollbar { width: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.15);
        border-radius: 99px;
      }
      ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.30); }
    </style>

    <script>
      document.addEventListener('astro:page-load', () => {
        const els = document.querySelectorAll('[data-animate],[data-animate-x]')
        if (!els.length) return
        const obs = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('visible')
              obs.unobserve(e.target)
            }
          })
        }, { threshold: 0.07, rootMargin: '0px 0px -20px 0px' })
        els.forEach(el => obs.observe(el))
      })
    </script>
  </body>
</html>
